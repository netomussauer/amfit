{
  // Usado so por `pnpm typecheck`. Next.js e Vitest leem tsconfig.json, nao este.
  //
  // No workspace completo o pnpm instala @types/react 18 (web) e 19 (mobile), e
  // o @tanstack/react-query do web acaba resolvendo os tipos 19 por hoisting,
  // gerando erros falsos ("bigint nao e ReactNode") nos testes de hooks. Mapear
  // react/react-dom para os tipos do proprio web forca uma unica versao.
  // Nao entra em tsconfig.json porque o Next aplica `paths` como alias de
  // bundler e quebraria o runtime.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  }
}
